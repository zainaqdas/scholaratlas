# ---------------------------------------------------------------------------
# ScholarAtlas environment variables
# Copy to .env (or .env.local) and fill in. Production values live in Vercel
# project settings and GitHub Actions secrets (for the weekly re-crawl).
# ---------------------------------------------------------------------------

# Database. Local dev: a SQLite file (file: URLs resolve relative to prisma/,
# so `file:./dev.db` becomes prisma/dev.db — matching `prisma db push`).
# Production: the Turso libsql:// URL.
DATABASE_URL=file:./dev.db

# Required for remote Turso databases (production + the weekly re-crawl job).
# Can be omitted for local dev.
TURSO_AUTH_TOKEN=

# Optional canonical origin override (e.g. https://scholaratlas.dev). When
# unset the site resolves the origin from the request host automatically.
NEXT_PUBLIC_APP_URL=

# Email (deadline reminders). Without RESEND_API_KEY the app runs normally and
# reminder sends are logged as skipped. Verify your sending domain at
# resend.com/domains so emails reach real recipients (test mode only delivers
# to the account owner's address).
RESEND_API_KEY=
RESEND_EMAIL_FROM=ScholarAtlas <hello@your-domain.com>

# Debug: log every Prisma query (0/1). Optional.
# DEBUG_PRISMA=1
