# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production

# import checkpoints (large, resumable artifacts)
/data/wms-global-details.jsonl
/data/wms-global-slugs.json
/data/wms-country-map.json
/data/wms-university-countries.json
/data/wms-levels-backfill.jsonl
/data/pts-programs.json
/data/pts-details.jsonl

# Turso migration dump (transient — regenerate with scripts/migrate-dump.ts)
/data/migration/

__pycache__/
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite dev database (regenerate with: npm run seed)
/prisma/dev.db
/prisma/dev.db-journal

# Local agent tooling (installed skills)
.agents/
skills-lock.json
